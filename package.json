{
  "name": "angular-remix-icon",
  "version": "8.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test angular-remix-icon --no-watch --browsers=ChromeHeadless",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:ci": "npm run verify:icons && npm run test:unit && npm run test:e2e",
    "verify:icons": "tsc scripts/verify-generated-icons.ts && node scripts/verify-generated-icons.js",
    "lint": "ng lint",
    "prepublishOnly": "npm run build:lib",
    "generate": "tsc -p scripts/tsconfig.json && node scripts/generate.js",
    "build:lib": "npm run generate && ng build angular-remix-icon --configuration production",
    "publish": "npm publish ./dist/angular-remix-icon"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^21.2.13",
    "@angular/common": "^21.2.13",
    "@angular/compiler": "^21.2.13",
    "@angular/core": "^21.2.13",
    "@angular/forms": "^21.2.13",
    "@angular/platform-browser": "^21.2.13",
    "@angular/platform-browser-dynamic": "^21.2.13",
    "@angular/router": "^21.2.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.13",
    "@types/del": "^4.0.0",
    "@types/estree": "^0.0.51",
    "@types/fs-extra": "^9.0.2",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^22.0.0",
    "@types/uppercamelcase": "^3.0.0",
    "codelyzer": "^6.0.0",
    "del": "^6.0.0",
    "fs-extra": "^9.0.1",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.2",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng-packagr": "^21.2.3",
    "nodemon": "^2.0.6",
    "prettier": "^3.1.0",
    "@playwright/test": "^1.52.0",
    "remixicon": "^4.9.1",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "5.9.3",
    "uppercamelcase": "^3.0.0"
  }
}
